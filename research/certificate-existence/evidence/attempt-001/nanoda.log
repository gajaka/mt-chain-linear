      (forall (C : PotentialSeparation.DriftCertificate n),
      LE.le
        (HDiv.hDiv
          (HSub.hSub
            (HPow.hPow (OfNat.ofNat 5)
              (HAdd.hAdd (HDiv.hDiv (HSub.hSub n (OfNat.ofNat 4)) (OfNat.ofNat 2)) (OfNat.ofNat 1))) (OfNat.ofNat 3))
          (OfNat.ofNat 36)) (PotentialSeparation.certificateBudget C))
      (And (LE.le (ENNReal.ofReal (HDiv.hDiv (Nat.cast n) (OfNat.ofNat 18))) (MTChainFormal.expectedSteps n))
        (LE.le (MTChainFormal.expectedSteps n) (ENNReal.ofReal (HMul.hMul (OfNat.ofNat 1054) (Nat.cast n)))))) :=
  _

