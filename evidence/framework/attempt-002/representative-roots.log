@MTProcess : {V : Type} → VarSpaces V → Type → Type
@FiniteResampling.Problem : {V : Type} → (V → Type) → Type → Type
@FiniteResampling.Policy : {V : Type} → (V → Type) → Type
@FiniteResampling.firstPolicy : {V : Type} →
  {D : V → Type} →
    [inst : (v : V) → Fintype (D v)] →
      [(v : V) → MeasurableSpace (D v)] →
        {I : Type} →
          [Fintype I] →
            [Nonempty I] →
              (Q : FiniteResampling.Marginals D) →
                FiniteResampling.Valid Q → FiniteResampling.Problem D I → FiniteResampling.Policy D
@randomInitETLog_le_sum : ∀ {V : Type} [inst : DecidableEq V] {S : VarSpaces V} {ι : Type} [inst_1 : Fintype ι]
  [inst_2 : DecidableEq ι] [inst_3 : Nonempty ι] [inst_4 : Fintype V] (P : MTProcess S ι),
  (∀ (i : ι), MeasurableSet (P.bad i)) →
    ∀ (p x : ι → NNReal),
      (∀ (i : ι), (MeasureTheory.Measure.pi fun v => S.measure v) (P.bad i) ≤ ↑(p i)) →
        (∀ (α : ι), p α ≤ x α) →
          (∀ (α : ι), p α * ∏ β ∈ plusNeighbors P α, (1 + x β) ≤ x α) → randomInitETLog P ≤ ↑(∑ α, x α)
'randomInitETLog_le_sum' depends on axioms: [propext, Classical.choice, Quot.sound]
@FiniteTable.nextDraw_fresh : ∀ {V : Type} [inst : Fintype V] [inst_1 : DecidableEq V] {S : VarSpaces V}
  [inst_2 : (v : V) → Fintype (S.space v)] [inst_3 : (v : V) → DecidableEq (S.space v)]
  [inst_4 : ∀ (v : V), MeasurableSingletonClass (S.space v)] (F : MTState S → Finset V) (init : LogSpace S → MTState S)
  (hi : Measurable init),
  FiniteTable.InitialLocal init →
    ∀ (n : ℕ) (a : MTState S),
      (logMeasure S)[FiniteDrift.stateIndicator (FiniteTable.nextDraw F init n) a |
          ↑(FiniteTable.history F init hi) n] =ᵐ[logMeasure S]
        fun x => ((FiniteTable.productLaw S) {a}).toReal
'FiniteTable.nextDraw_fresh' depends on axioms: [propext, Classical.choice, Quot.sound]
@FiniteResampling.randomInitETLog_eq_rational_sum_of_equations : ∀ {V : Type} [inst : Fintype V]
  [inst_1 : DecidableEq V] {D : V → Type} [inst_2 : (v : V) → Fintype (D v)] [inst_3 : (v : V) → DecidableEq (D v)]
  [inst_4 : (v : V) → MeasurableSpace (D v)] [∀ (v : V), MeasurableSingletonClass (D v)] {I : Type} [inst_6 : Fintype I]
  [inst_7 : DecidableEq I] [inst_8 : Nonempty I] (Q : FiniteResampling.Marginals D) (h : FiniteResampling.Valid Q)
  (B : FiniteResampling.Problem D I) (f : FiniteResampling.State D → ℚ),
  FinitePotential.Equations (FiniteUpdate.model (FiniteResampling.rule Q (FiniteResampling.firstPolicy Q h B))) f →
    randomInitETLog (FiniteResampling.mtProcess Q h B) = ENNReal.ofReal ↑(∑ s, FiniteResampling.productMass Q s * f s)
'FiniteResampling.randomInitETLog_eq_rational_sum_of_equations' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
