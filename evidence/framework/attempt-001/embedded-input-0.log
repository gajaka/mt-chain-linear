LucesCertificateRepair.contract_source_bytes :
  LucesCertificateRepair.contractFileBytes = LucesObservedInputs.contractBytes
LucesCertificateRepair.contract_source_decodes :
  LucesCertificateRepair.decodeContract LucesCertificateRepair.contractFileBytes = some LucesObservedInputs.baseChecks
LucesCertificateRepair.observed_source_bytes :
  LucesCertificateRepair.observedFileBytes = LucesObservedInputs.kernelBytes
LucesCertificateRepair.observed_rows_decode :
  LucesCertificateRepair.decodeRows LucesCertificateRepair.observedFileBytes = some LucesObservedInputs.snapshotRows
LucesCertificateRepair.locality_derived :
  CertificationDependency.FamilyLocal LucesCertificateRepair.F LucesCertificateRepair.vars ()
LucesCertificateRepair.target_reads :
  LucesCertificateRepair.vars LucesCertificateRepair.target =
    {LucesObservedInputs.Field.validRows, LucesObservedInputs.Field.mongeFraction, LucesObservedInputs.Field.violations,
      LucesObservedInputs.Field.nnz}
LucesCertificateRepair.duplicate_preserved :
  FiniteReadCertificates.indexedCheck LucesCertificateRepair.checks LucesCertificateRepair.duplicateMonge =
    LucesObservedInputs.baseChecks[1]!
LucesCertificateRepair.before_target_fails :
  ¬CertificationDependency.holds LucesCertificateRepair.F () LucesCertificateRepair.target LucesObservedInputs.before
LucesCertificateRepair.protected_generator_before :
  CertificationDependency.holds LucesCertificateRepair.F () LucesCertificateRepair.generator LucesObservedInputs.before
LucesCertificateRepair.protected_provenance_before :
  CertificationDependency.holds LucesCertificateRepair.F () LucesCertificateRepair.provenance LucesObservedInputs.before
LucesCertificateRepair.finite_search_selects_candidate :
  FiniteReadCertificates.search LucesCertificateRepair.checks
      (LucesCertificateRepair.vars LucesCertificateRepair.target) LucesObservedInputs.before LucesObservedInputs.bank =
    some LucesObservedInputs.after
LucesCertificateRepair.selected_candidate_in_bank : LucesObservedInputs.after ∈ LucesObservedInputs.bank
LucesCertificateRepair.component_check_derived :
  CertificationDependency.ComponentChecked LucesCertificateRepair.F LucesCertificateRepair.vars ()
    LucesCertificateRepair.target LucesObservedInputs.before LucesObservedInputs.after
LucesCertificateRepair.selected_repair_restores_and_preserves :
  CertificationDependency.holds LucesCertificateRepair.F () LucesCertificateRepair.target LucesObservedInputs.after ∧
    ∀ C ∈ LucesCertificateRepair.F.certs, C LucesObservedInputs.before () → C LucesObservedInputs.after ()
LucesCertificateRepair.selected_repair_fully_certifies :
  fully_certified LucesCertificateRepair.F LucesObservedInputs.after ()
LucesCertificateRepair.generator_and_provenance_fixed :
  LucesObservedInputs.before LucesObservedInputs.Field.generatorCos =
      LucesObservedInputs.after LucesObservedInputs.Field.generatorCos ∧
    LucesObservedInputs.before LucesObservedInputs.Field.datasetKey =
      LucesObservedInputs.after LucesObservedInputs.Field.datasetKey
